# Local development only. The API currently binds to 127.0.0.1.
HUB_API_PORT=3177

# Local PostgreSQL for R3 identity and sessions. Compose reads HUB_DB_PORT.
HUB_DB_PORT=5439
# Set DATABASE_URL externally to override the local Compose connection.
# DATABASE_URL=
# Optional first-boot admin identity. Set the password in your local environment.
INITIAL_ADMIN_EMAIL=admin@hublink.local
# INITIAL_ADMIN_PASSWORD=
# Supply VAULT_MASTER_KEY securely at runtime only when the vault is implemented.
# VAULT_MASTER_KEY=
