# Local development only. The API currently binds to 127.0.0.1.
HUB_API_PORT=3177

# PostgreSQL scaffold for the future private variant. Compose reads HUB_DB_PORT.
HUB_DB_PORT=5439
# Future API configuration; the current demo API does not read these values.
HUB_DB_HOST=127.0.0.1
HUB_DB_NAME=hublink
HUB_DB_USER=hublink
HUB_DB_PASSWORD=hublink_dev_password
# Supply VAULT_MASTER_KEY securely at runtime only when the vault is implemented.
# VAULT_MASTER_KEY=
