# Local development only. The API currently binds to 127.0.0.1.
HUB_API_PORT=3177

# Local PostgreSQL for R3 identity and sessions. Compose reads HUB_DB_PORT.
HUB_DB_PORT=5439
# Set DATABASE_URL externally to override the local Compose connection.
# DATABASE_URL=
# Optional first-boot admin identity. Set the password in your local environment.
INITIAL_ADMIN_EMAIL=admin@hublink.local
# INITIAL_ADMIN_PASSWORD=
# 32-byte secret key (64 hex characters or 32 raw bytes) for AES-256-GCM vault encryption.
# In production, this is strictly required on API boot (fail-closed).
# VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# R8 production: copy into a private .env.production, never commit that file.
# Compose interpolation AND runtime must use the same env file.
# Run: docker compose --env-file .env.production -f docker-compose.prod.yml ...
HUB_PROJECT_NAME=hublink-prod
HUB_API_HOST=127.0.0.1
HUB_TRUST_PROXY=false
HUB_CLIENT_ORIGINS=http://127.0.0.1:5177,http://localhost:5177
HUB_WEB_PORT=8080
HUB_DATA_DIR=./data/production
# POSTGRES_PASSWORD= # Generate a random hex password (URL-safe).
POSTGRES_DB=hublink
# Set INITIAL_ADMIN_EMAIL and INITIAL_ADMIN_PASSWORD explicitly for production.
# HUB_API_IMAGE=hublink-api:release-tag
# HUB_WEB_IMAGE=hublink-web:release-tag
# HUB_RUNTIME_ENV_FILE=.env.production
# BACKUP_PASSPHRASE is supplied separately at operation time, not in images.
