{
  "manifest_version": 3,
  "name": "Hublink (base local)",
  "version": "0.1.0",
  "description": "Ponte local de bilhetes Hublink com motor universal de preenchimento assistido.",
  "key": "",
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://*/*", "http://127.0.0.1:3177/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:5177/*", "http://127.0.0.1:5177/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost:5177/*", "http://127.0.0.1:5177/*"]
  }
}
